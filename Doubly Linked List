//Doubly Linked List
#include<iostream>
#include <climits>
using namespace std;
class Node{
	public:
		int data;
		Node* prev;
		Node* next;
		
		Node(int value){
			data = value;
			prev = 0;
			next = 0;
		}
};
//displaying a doubly linked list (same as singly)
void displayLinkedlist(Node* head){
	Node* temp = head;
	while(temp != 0){
		cout<<temp->data<<"->";
		temp = temp->next;
	}
	cout<<"Null"<<endl;
}
